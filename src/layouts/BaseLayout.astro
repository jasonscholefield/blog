---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  containerClass?: string;
}

const {
  title,
  description = 'Writing about UX and game design, one game at a time.',
  containerClass = 'max-w-3xl',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-bg text-fg antialiased">
    <div class={`mx-auto flex min-h-screen ${containerClass} flex-col px-6`}>
      <header class="flex items-center justify-between py-8">
        <a href="/" class="font-mono text-sm font-medium text-fg hover:text-fg-muted">
          deckard_pain<span class="logo-cursor" aria-hidden="true"></span>
        </a>
        <nav class="flex items-center gap-5 text-sm text-fg-muted">
          <a href="/" class="hover:text-fg">Writing</a>
          <a href="/rss.xml" class="hover:text-fg">RSS</a>
        </nav>
      </header>

      <main class="flex-1 pb-24">
        <slot />
      </main>

      <footer class="flex flex-col gap-4 border-t border-border py-8 text-xs text-fg-subtle sm:flex-row sm:items-center sm:justify-between">
        <p>&copy; {new Date().getFullYear()} — built with Astro.</p>
        <ul class="flex flex-wrap gap-5">
          <li>
            <a
              href="https://www.goodreads.com/user/show/25770377-deckard"
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-fg"
            >
              Goodreads
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="transition-colors hover:text-fg">RSS</a>
          </li>
        </ul>
      </footer>
    </div>

    <script>
      // Link hover: letters scramble and settle left to right over ~420ms.
      // The real text stays in place (made transparent) with the scramble drawn on top,
      // so nothing around the link shifts while it runs.
      const UPPER = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#%&*+=/<>';
      const LOWER = 'abcdefghjkmnpqrstuvwxyz0123456789';
      const DURATION = 420;
      const BLOCK_CONTENT = 'img, picture, svg, video, div, p, h1, h2, h3, h4, h5, h6';
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const frames = new WeakMap<HTMLAnchorElement, number>();

      function scramble(text: string, progress: number) {
        const chars = Array.from(text);
        const revealed = Math.floor(progress * chars.length);
        return chars
          .map((ch, i) => {
            if (i < revealed || !/[a-z0-9]/i.test(ch)) return ch;
            const pool = /[a-z]/.test(ch) ? LOWER : UPPER;
            return pool[Math.floor(Math.random() * pool.length)];
          })
          .join('');
      }

      // Only links with a single run of text (plus empty decoration like the logo cursor).
      function textNodeOf(link: HTMLAnchorElement) {
        if (link.querySelector(BLOCK_CONTENT)) return null;
        const walker = document.createTreeWalker(link, NodeFilter.SHOW_TEXT);
        let found: Text | null = null;
        for (let node = walker.nextNode(); node; node = walker.nextNode()) {
          if (!node.textContent?.trim()) continue;
          if (found) return null;
          found = node as Text;
        }
        return found;
      }

      function run(link: HTMLAnchorElement) {
        if (reduceMotion.matches) return;

        let wrap = link.querySelector<HTMLElement>('.link-scramble');
        if (!wrap) {
          // A link wrapping across lines can't be overlaid cleanly, so it only gets the underline.
          if (link.getClientRects().length > 1) return;
          const node = textNodeOf(link);
          if (!node) return;
          wrap = document.createElement('span');
          wrap.className = 'link-scramble';
          const source = document.createElement('span');
          source.dataset.source = '';
          const fx = document.createElement('span');
          fx.dataset.fx = '';
          fx.setAttribute('aria-hidden', 'true');
          node.replaceWith(wrap);
          source.append(node);
          wrap.append(source, fx);
        }

        const node = wrap.querySelector('[data-source]')!.firstChild as Text;
        const fx = wrap.querySelector<HTMLElement>('[data-fx]')!;
        const text = node.textContent ?? '';
        const finalWrap = wrap;
        const start = performance.now();
        let tick = 0;

        cancelAnimationFrame(frames.get(link) ?? 0);
        const step = (now: number) => {
          const progress = (now - start) / DURATION;
          if (progress >= 1) {
            finalWrap.replaceWith(node);
            frames.delete(link);
            return;
          }
          // Swapping glyphs every other frame reads as flicker rather than noise.
          if (tick++ % 2 === 0) fx.textContent = scramble(text, progress);
          frames.set(link, requestAnimationFrame(step));
        };
        frames.set(link, requestAnimationFrame(step));
      }

      document.addEventListener('pointerover', (event) => {
        const link = (event.target as Element).closest?.('a');
        if (!link || link.contains(event.relatedTarget as Node | null)) return;
        run(link);
      });

      document.addEventListener('focusin', (event) => {
        const link = (event.target as Element).closest?.('a');
        if (link?.matches(':focus-visible')) run(link);
      });
    </script>
  </body>
</html>
