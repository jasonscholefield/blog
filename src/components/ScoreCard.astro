---
interface Props {
  score: number;
  outOf?: number;
  title: string;
  author: string;
  year?: string | number;
  verdict?: string;
}

const { score, outOf = 10, title, author, year, verdict } = Astro.props;
---

<figure
  class="not-prose my-12 border-t border-fg"
  aria-label={`Score: ${score} out of ${outOf}`}
>
  {verdict && (
    <div class="pt-3 pb-5">
      <div class="mb-2.5 font-mono text-xs text-fg-muted">Verdict</div>
      <p class="text-2xl font-medium leading-tight tracking-tight text-fg sm:text-3xl">{verdict}</p>
    </div>
  )}
  <div class:list={["grid grid-cols-2 border-b border-border-strong", verdict && "border-t"]}>
    <figcaption class="flex flex-col justify-between py-6 font-mono text-xs leading-relaxed text-fg-muted">
      <span>Score</span>
      <span>
        {title}<br />
        {author}
        {year && <><br />{year}</>}
      </span>
    </figcaption>
    <div class="flex items-start justify-end border-l border-border-strong py-10 pl-5 sm:pl-6" aria-hidden="true">
      <span class="score-number font-medium text-fg">{score}</span>
      <span class="score-out-of font-medium text-fg-subtle">/{outOf}</span>
    </div>
  </div>
</figure>

<style>
  .score-number {
    font-size: clamp(7rem, 30vw, 11.5rem);
    line-height: 0.75;
    letter-spacing: -0.06em;
  }

  .score-out-of {
    font-size: clamp(1.25rem, 5vw, 1.75rem);
    line-height: 1;
    margin-left: 0.25rem;
  }
</style>
