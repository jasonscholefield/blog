---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import TagPill from './TagPill.astro';

interface Props {
  slug: string;
  title: string;
  summary: string;
  date: Date;
  tags: string[];
  readingTime: number;
  coverImage?: ImageMetadata;
  featured?: boolean;
}

const { slug, title, summary, date, tags, readingTime, coverImage, featured = false } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

const placeholderStyle =
  'background-image: repeating-linear-gradient(135deg, var(--color-bg-elevated-hover) 0, var(--color-bg-elevated-hover) 7px, #191919 7px, #191919 14px);';
---

<a
  href={`/blog/${slug}`}
  class="group block overflow-hidden rounded-xl border border-border bg-bg-elevated transition-colors hover:border-border-strong hover:bg-bg-elevated-hover"
>
  {featured ? (
    <>
      {coverImage ? (
        <Image
          src={coverImage}
          alt=""
          width={960}
          height={540}
          class="aspect-video w-full object-cover"
        />
      ) : (
        <div class="flex aspect-video w-full items-center justify-center" style={placeholderStyle}>
          <span class="px-6 text-center text-2xl font-bold tracking-tight text-fg-subtle">
            {title}
          </span>
        </div>
      )}
      <div class="p-5">
        <div class="flex items-center gap-2 text-xs text-fg-subtle">
          <span>{formattedDate}</span>
          <span aria-hidden="true">&middot;</span>
          <span>{readingTime} min read</span>
        </div>
        <h2 class="mt-2 font-sans text-lg font-semibold text-fg group-hover:text-fg">
          {title}
        </h2>
        <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-fg-muted">
          {summary}
        </p>
        {tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => <TagPill tag={tag} />)}
          </div>
        )}
      </div>
    </>
  ) : (
    <div class="flex items-start gap-4 p-5">
      {coverImage ? (
        <Image
          src={coverImage}
          alt=""
          width={160}
          height={90}
          class="aspect-video w-40 flex-shrink-0 rounded-lg object-cover"
        />
      ) : (
        <div class="flex aspect-video w-40 flex-shrink-0 items-center justify-center rounded-lg" style={placeholderStyle}>
          <span class="text-lg font-bold text-fg-subtle">{title.charAt(0)}</span>
        </div>
      )}
      <div class="min-w-0">
        <div class="flex items-center gap-2 text-xs text-fg-subtle">
          <span>{formattedDate}</span>
          <span aria-hidden="true">&middot;</span>
          <span>{readingTime} min read</span>
        </div>
        <h2 class="mt-2 font-sans text-lg font-semibold text-fg group-hover:text-fg">
          {title}
        </h2>
        <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-fg-muted">
          {summary}
        </p>
        {tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => <TagPill tag={tag} />)}
          </div>
        )}
      </div>
    </div>
  )}
</a>
